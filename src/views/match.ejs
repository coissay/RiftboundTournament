<%- include('partials/head', { title: `Table ${match.table} — ${tournament.name}` }) %>

<p><a href="/tournaments/<%= tournament._id %>" class="muted">← <%= tournament.name %></a></p>

<div class="card match-card">
  <p class="muted match-meta">Ronde <%= round.number %> · Table <%= match.table %> · Bo<%= tournament.bestOf || 1 %></p>

  <% const g = match.games || { p1: 0, p2: 0, draws: 0 }; %>
  <% const bestOf = tournament.bestOf || 1; %>
  <% const need = Math.ceil(bestOf / 2); %>
  <% const played = Array.isArray(match.gameResults) ? match.gameResults.length : 0; %>
  <% const decided = g.p1 === need || g.p2 === need || played >= bestOf; %>

  <div class="versus">
    <div class="versus-side <%= match.result === 'p1' && decided ? 'versus-winner' : '' %>">
      <span class="versus-name"><%= match.p1.username %></span>
      <span class="muted">(<%= recordOf[String(match.p1.userId)] || '0-0-0' %>)</span>
      <span class="muted deck-tag"><%= match.p1.deckName %></span>
    </div>
    <div class="versus-center">
      <div class="versus-score"><%= g.p1 %> — <%= g.p2 %></div>
      <% if (g.draws) { %><div class="muted"><%= g.draws %> manche<%= g.draws > 1 ? 's' : '' %> nulle<%= g.draws > 1 ? 's' : '' %></div><% } %>
      <div class="versus-vs">VS</div>
    </div>
    <div class="versus-side <%= match.result === 'p2' && decided ? 'versus-winner' : '' %>">
      <span class="versus-name"><%= match.p2.username %></span>
      <span class="muted">(<%= recordOf[String(match.p2.userId)] || '0-0-0' %>)</span>
      <span class="muted deck-tag"><%= match.p2.deckName %></span>
    </div>
  </div>

  <% if (played > 0) { %>
    <div class="manche-history">
      <% match.gameResults.forEach((r, i) => { %>
        <div class="manche-line">
          <span class="muted">Manche <%= i + 1 %></span>
          <% if (r === 'draw') { %><span class="result-chip draw">Nul</span>
          <% } else { %><span class="result-chip win">Victoire <%= r === 'p1' ? match.p1.username : match.p2.username %></span><% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (canReport && !decided) { %>
    <div class="manche-report">
      <p class="manche-title">Manche <%= played + 1 %> — qui l'emporte ?</p>
      <div class="report-buttons">
        <form method="post" action="/tournaments/<%= tournament._id %>/rounds/<%= round.number %>/tables/<%= match.table %>/games">
          <input type="hidden" name="gameResult" value="p1">
          <button class="btn btn-report btn-win-left"><%= match.p1.username %><span>Victoire</span></button>
        </form>
        <form method="post" action="/tournaments/<%= tournament._id %>/rounds/<%= round.number %>/tables/<%= match.table %>/games">
          <input type="hidden" name="gameResult" value="draw">
          <button class="btn btn-report btn-draw-mid">Nul<span>Égalité</span></button>
        </form>
        <form method="post" action="/tournaments/<%= tournament._id %>/rounds/<%= round.number %>/tables/<%= match.table %>/games">
          <input type="hidden" name="gameResult" value="p2">
          <button class="btn btn-report btn-win-right"><%= match.p2.username %><span>Victoire</span></button>
        </form>
      </div>
      <p class="muted">Première à <%= need %> manche<%= need > 1 ? 's' : '' %> gagnée<%= need > 1 ? 's' : '' %>. Si le temps est écoulé, laisse le score en l'état : il compte tel quel.</p>
    </div>
  <% } else if (decided) { %>
    <div class="cup-banner match-final">
      <% if (match.result === 'draw') { %>Match nul <%= g.p1 %>-<%= g.p2 %>
      <% } else { %>🎉 <strong><%= match.result === 'p1' ? match.p1.username : match.p2.username %></strong> remporte le match <%= match.result === 'p1' ? g.p1 + '-' + g.p2 : g.p2 + '-' + g.p1 %><% } %>
    </div>
  <% } else if (!canReport && tournament.status === 'en_cours' && round.number === tournament.rounds.length) { %>
    <p class="muted">Seuls les joueurs de la table ou l'organisateur peuvent saisir le résultat<%= currentUser ? '' : ' — connecte-toi' %>.</p>
  <% } %>

  <% if (canReport && played > 0) { %>
    <form method="post" action="/tournaments/<%= tournament._id %>/rounds/<%= round.number %>/tables/<%= match.table %>/reset"
          class="reset-form" onsubmit="return confirm('Effacer toutes les manches saisies pour ce match ?')">
      <button class="btn btn-ghost btn-small">↺ Réinitialiser la saisie</button>
    </form>
  <% } %>
</div>

<% if (tournament.status === 'en_cours' && round.number === tournament.rounds.length) { %>
  <div class="timer-bar" data-started="<%= round.startedAt.getTime() %>" data-length="<%= tournament.roundLength %>">
    <span>Temps de ronde</span>
    <span class="timer" id="round-timer">--:--</span>
  </div>
  <script src="/timer.js"></script>
<% } %>

<%- include('partials/foot') %>
