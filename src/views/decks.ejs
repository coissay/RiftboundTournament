<%- include('partials/head', { title: 'Mes decks' }) %>

<div class="page-head">
  <h1>Mes decks</h1>
  <div class="row-actions">
    <a href="/deckbuilder" class="btn btn-ghost">Deckbuilder</a>
    <a href="/decks/new" class="btn btn-gold">+ Nouveau deck</a>
  </div>
</div>

<% if (decks.length === 0) { %>
  <div class="empty">Aucun deck. Crée ton premier deck pour pouvoir t'inscrire aux tournois !</div>
<% } %>

<div class="deck-grid">
<% for (const d of decks) { const r = d.resolved; %>
  <div class="card deck-card">
    <div class="deck-card-head">
      <% if (r.legendCard && r.legendCard.image) { %>
        <a href="/decks/<%= d._id %>" class="deck-card-legend card-thumb" data-full="<%= r.legendCard.image %>"><img src="<%= thumb(r.legendCard.image, 200) %>" alt="<%= r.legend %>" loading="lazy"></a>
      <% } %>
      <div>
        <h2><a href="/decks/<%= d._id %>"><%= d.name %></a></h2>
        <% if (d.legend) { %><p class="legend">Légende : <strong><%= d.legend %></strong></p><% } %>
        <% if (r.champion) { %><p class="legend muted">Champion : <%= r.champion %></p><% } %>
        <% if (d.domains && d.domains.length) { %>
          <p><% for (const dom of d.domains) { %><span class="domain domain-<%= dom.toLowerCase() %>"><%= dom %></span><% } %></p>
        <% } %>
      </div>
    </div>
    <% if (!r.empty) { %>
      <p class="muted"><%= r.total %> carte(s)<% if (r.unknown) { %> · <span class="warn">⚠ <%= r.unknown %> non reconnue(s)</span><% } %><% if (d.battlefields) { %> · <%= d.battlefields %><% } %></p>
    <% } %>
    <% if (d.notes) { %><p class="muted deck-notes"><%= d.notes %></p><% } %>
    <div class="row-actions">
      <a href="/decks/<%= d._id %>" class="btn btn-ghost">Voir</a>
      <a href="/decks/<%= d._id %>/edit" class="btn btn-ghost">Modifier</a>
      <a href="/deckbuilder?deck=<%= d._id %>" class="btn btn-ghost">Ouvrir dans le deckbuilder</a>
      <form method="post" action="/decks/<%= d._id %>/delete" class="inline" onsubmit="return confirm('Supprimer ce deck ?')">
        <button class="btn btn-danger">Supprimer</button>
      </form>
    </div>
  </div>
<% } %>
</div>

<%- include('partials/foot') %>
