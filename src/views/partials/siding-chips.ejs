<%
/* Résumé d'un side (pastilles sorties / entrées, note, deck joué).
   Attend : sd (side), sdk (deck après side ou null), n (manche), cardImage, thumb, inline (bool, optionnel : une seule ligne). */
const isInline = typeof inline !== 'undefined' && inline;
%>
<% if (isInline) { %>
  <span class="siding-inline-chips">
    <% for (const c of sd.out) { %><span class="diff-chip diff-del">−<%= c.qty %> <%- include('card-name', { name: c.name, cardImage }) %></span><% } %>
    <% for (const c of sd.in) { %><span class="diff-chip diff-add">+<%= c.qty %> <%- include('card-name', { name: c.name, cardImage }) %></span><% } %>
    <% if (!sd.out.length && !sd.in.length) { %><span class="muted">aucun échange</span><% } %>
    <% if (sd.note) { %><span class="muted siding-note-inline">« <%= sd.note %> »</span><% } %>
  </span>
<% } else { %>
  <div class="siding-lists">
    <div><span class="muted">Sorties</span><% if (sd.out.length === 0) { %> <span class="muted">—</span><% } %>
      <ul class="siding-list"><% for (const c of sd.out) { %><li><span class="diff-chip diff-del">−<%= c.qty %> <%- include('card-name', { name: c.name, cardImage }) %></span></li><% } %></ul>
    </div>
    <div><span class="muted">Entrées</span><% if (sd.in.length === 0) { %> <span class="muted">—</span><% } %>
      <ul class="siding-list"><% for (const c of sd.in) { %><li><span class="diff-chip diff-add">+<%= c.qty %> <%- include('card-name', { name: c.name, cardImage }) %></span></li><% } %></ul>
    </div>
  </div>
  <% if (sd.note) { %><p class="siding-note"><%= sd.note %></p><% } %>
<% } %>
<% if (sdk) { %>
  <details class="sided-deck">
    <summary class="btn btn-ghost btn-small">🃏 Deck joué en manche <%= n %> <span class="muted">(principal <%= sdk.mainCount %> · réserve <%= sdk.sideCount %>)</span></summary>
    <div class="sided-deck-view">
      <p class="muted"><span class="sided-badge sided-badge-inline sided-in">IN</span> entrée dans le deck principal, <span class="sided-badge sided-badge-inline sided-out">OUT</span> sortie en réserve, par rapport au deck inscrit.</p>
      <%- include('deck-view', { resolved: sdk.resolved, thumb, compact: true, highlight: sdk.highlight }) %>
    </div>
  </details>
<% } %>
