<%- include('../partials/head', { title: `Match ${spec.label} — Free play` }) %>

<p><a href="/free-play" class="muted">← Free play</a></p>

<div class="card match-card">
  <h1 class="fp-match-title">Free play · <%= spec.label %> · Bo<%= match.bestOf || 1 %></h1>
  <p class="muted match-meta">
    <span class="badge badge-<%= match.status === 'en_cours' ? 'live' : 'done' %>"><%= match.status === 'en_cours' ? '● En cours' : match.result === 'draw' ? 'Nul' : 'Terminé' %></span>
    · <%= match.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %>
    à <%= match.date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %>
    · créé par <%= match.creatorName %>
  </p>
  <% if (match.notes) { %><p class="muted match-notes"><%= match.notes %></p><% } %>

  <% const need = Math.ceil((match.bestOf || 1) / 2); %>
  <% const firstId = match.firstPlayer ? String(match.firstPlayer.userId) : null; %>
  <% const catchUp = me && match.status !== 'terminé' ? sidingGames.filter((n) => n <= games.played) : []; %>
  <% const players = match.sides.flatMap((s) => s.players); const myId = me ? String(me.userId) : null; const sidingAction = `/free-play/${match._id}/siding`; %>
  <% const sideLineOf = (p, n) => { const uid = String(p.userId); const sd = siding[uid].games[n]; return (uid === myId ? 'mon side' : p.username) + ' : ' + (sd ? (sidingVisible[uid] ? sideSummary(sd) : '🔒 side renseigné, visible à la clôture') : 'rien de noté'); }; %>
  <% const prevSideOf = (n) => { let prev = null; for (let k = n - 1; k >= sidingGames[0] && !prev; k--) prev = mySiding.games[k] || null; return prev; }; %>
  <% const iStart = !!(firstId && currentUser && firstId === currentUser.id); %>

  <% if (tiebreak) { %>
    <div class="callout callout-gold fp-tiebreak" role="status">
      <span class="callout-icon" aria-hidden="true">⚖️</span>
      <span><strong>Égalité en tête après <%= games.played %> manche<%= games.played > 1 ? 's' : '' %> :</strong> manche de départage — on continue jusqu'à ce qu'un seul côté soit en tête<%= games.played + 1 >= maxGames ? ' (dernière manche possible : le match se clôture ensuite au score)' : '' %>.</span>
    </div>
  <% } %>

  <% const missingDeck = players.filter((p) => !p.deckId && canSetDeckOf[String(p.userId)]); %>
  <% if (missingDeck.length) { const onlyMe = missingDeck.length === 1 && String(missingDeck[0].userId) === currentUser.id; %>
    <div class="callout callout-gold fp-deck-callout" id="fp-deck-callout" role="status">
      <span class="callout-icon" aria-hidden="true">🃏</span>
      <div class="fp-deck-callout-body">
        <p class="fp-deck-callout-title">
          <% if (onlyMe) { %><strong>Ton deck n'est pas renseigné pour ce match.</strong>
          <% } else if (missingDeck.length === 1) { %><strong><%= missingDeck[0].username %> n'a pas de deck renseigné.</strong>
          <% } else { %><strong>Decks non renseignés :</strong> <%= missingDeck.map((p) => (String(p.userId) === currentUser.id ? 'toi' : p.username)).join(', ') %>.<% } %>
          <span class="muted">Sans deck, le match ne compte pas dans les stats par deck — tu peux le déclarer maintenant, même après la partie.</span>
        </p>
        <% for (const p of missingDeck) { const uid = String(p.userId); const isMe = uid === currentUser.id; const list = decksByPlayer[uid] || []; %>
          <form method="post" action="/free-play/<%= match._id %>/deck" class="fp-deck-form fp-deck-callout-form">
            <input type="hidden" name="userId" value="<%= uid %>">
            <% if (!onlyMe) { %><span class="fp-deck-who"><%= isMe ? 'Mon deck' : p.username %></span><% } %>
            <% if (list.length) { %>
              <select name="deckId" required aria-label="Deck de <%= isMe ? 'moi' : p.username %>">
                <option value="">— choisir un deck —</option>
                <% for (const d of list) { %><option value="<%= d.id %>"><%= d.name %></option><% } %>
              </select>
              <button class="btn btn-gold"><%= isMe ? 'Déclarer mon deck' : 'Déclarer son deck' %></button>
            <% } else if (isMe) { %>
              <span class="muted">Tu n'as encore aucun deck enregistré.</span> <a href="/decks" class="btn btn-gold">Créer mon deck</a>
            <% } else if (isGuest[uid]) { %>
              <span class="muted"><%= p.username %> n'a aucun deck enregistré — il/elle pourra le déclarer une fois son compte créé.</span>
            <% } else { %>
              <span class="muted"><%= p.username %> n'a aucun deck enregistré.</span>
            <% } %>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>

  <div class="versus versus-<%= spec.sides %>">
    <% match.sides.forEach((side, i) => { %>
      <% if (i > 0) { %>
        <div class="versus-center">
          <% if (spec.sides === 2) { %>
            <div class="versus-score"><%= games.wins[0] %> — <%= games.wins[1] %></div>
            <% if (games.draws) { %><div class="muted"><%= games.draws %> manche<%= games.draws > 1 ? 's' : '' %> nulle<%= games.draws > 1 ? 's' : '' %></div><% } %>
          <% } %>
          <div class="versus-vs"><%= match.status === 'terminé' ? 'FINAL' : tiebreak ? 'DÉPARTAGE' : games.played ? 'MANCHE ' + (games.played + 1) : 'VS' %></div>
        </div>
      <% } %>
      <div class="versus-side <%= match.result === i && match.status === 'terminé' ? 'versus-winner' : '' %>">
        <% if (spec.perSide > 1) { %><span class="muted fp-team-label"><%= i === 0 ? 'Équipe A' : 'Équipe B' %></span><% } %>
        <% for (const p of side.players) { %>
          <div class="fp-player">
            <a class="versus-name" href="/players/<%= p.userId %>"><%= p.username %></a>
            <% if (firstId === String(p.userId)) { %><span class="tag tag-gold fp-first <%= iStart ? 'fp-first-me' : '' %>" title="Premier joueur de la manche 1 (tiré au sort)<%= spec.perSide > 1 ? ' — son équipe commence' : '' %>"><%- include('../partials/icon', { name: 'dice' }) %> <%= iStart ? 'Tu commences' : 'commence' %></span><% } %>
            <span class="muted" title="Bilan V-N-D en free play <%= spec.label %>">(<%= recordOf[String(p.userId)] || '0-0-0' %>)</span>
            <% if (p.deckName) { %>
              <span class="muted deck-tag"><% if (p.deckId && currentUser) { %><a href="/decks/<%= p.deckId %>"><%= p.deckName %></a><% } else { %><%= p.deckName %><% } %><%= p.deckVersion ? ' v' + p.deckVersion : '' %></span>
            <% } else { %>
              <span class="muted deck-tag"><em>deck non renseigné</em></span>
            <% } %>
            <% if (canSetDeckOf[String(p.userId)] && !p.deckId) { %>
              <a href="#fp-deck-callout" class="btn btn-gold btn-small fp-deck-declare">🃏 Déclarer <%= String(p.userId) === currentUser.id ? 'mon' : 'son' %> deck</a>
            <% } else if (canSetDeckOf[String(p.userId)]) { const myDecks = decksByPlayer[String(p.userId)] || []; %>
              <details class="fp-deck-edit">
                <summary class="btn btn-ghost btn-small">✎ Modifier</summary>
                <% if (myDecks.length) { %>
                  <form method="post" action="/free-play/<%= match._id %>/deck" class="fp-deck-form">
                    <input type="hidden" name="userId" value="<%= p.userId %>">
                    <select name="deckId">
                      <option value="">— sans deck —</option>
                      <% for (const d of myDecks) { %><option value="<%= d.id %>" <%= String(p.deckId) === d.id ? 'selected' : '' %>><%= d.name %></option><% } %>
                    </select>
                    <button class="btn btn-gold btn-small">Enregistrer</button>
                  </form>
                  <span class="muted">Version du deck à la date du match ; modifiable même après clôture.</span>
                <% } else { %>
                  <span class="muted">Aucun deck enregistré pour <%= String(p.userId) === currentUser.id ? 'toi' : p.username %><% if (String(p.userId) === currentUser.id) { %> — <a href="/decks">crée-en un</a><% } %>.</span>
                <% } %>
              </details>
            <% } %>
          </div>
        <% } %>
        <% if (spec.sides > 2) { %><span class="fp-side-score"><%= games.wins[i] %></span><% } %>
      </div>
    <% }) %>
  </div>

  <% if (spec.sides > 2 && games.draws) { %><p class="muted match-meta"><%= games.draws %> manche<%= games.draws > 1 ? 's' : '' %> nulle<%= games.draws > 1 ? 's' : '' %></p><% } %>

  <% if (games.played > 0) { %>
    <div class="manche-history">
      <% match.gameResults.forEach((r, i) => { const n = i + 1; %>
        <div class="manche-line">
          <span class="muted">Manche <%= n %><%= n > (match.bestOf || 1) ? ' (départage)' : '' %></span>
          <% if (r === 'draw') { %><span class="result-chip draw">Nul</span>
          <% } else { %><span class="result-chip win">Victoire <%= sideName(match.sides[r]) %></span><% } %>
        </div>
        <% const anySide = players.some((p) => siding[String(p.userId)].games[n]); %>
        <% if (anySide) { %>
        <div class="manche-side">
          <% if (!sidingGames.includes(n)) { %><span class="muted">decks inscrits pour tout le monde</span>
          <% } else { for (const p of players) { const uid = String(p.userId); const sd = siding[uid].games[n]; %>
            <span class="manche-side-player"><span class="muted"><%= uid === myId ? 'Mon side' : p.username %> :</span>
              <% if (!sd) { %><span class="muted">—</span>
              <% } else if (!sidingVisible[uid]) { %><span class="muted">🔒 jusqu'à la clôture</span>
              <% } else { %><%- include('../partials/siding-chips', { sd, sdk: sidedDecks[uid][n] || null, n, cardImage, thumb, inline: true }) %><% } %>
            </span>
          <% } } %>
        </div>
        <% } %>
      <% }) %>
    </div>
  <% } %>

  <% if (canReport && !decided) { %>
    <div class="manche-report">
      <p class="manche-title">Manche <%= games.played + 1 %><%= tiebreak ? ' (départage)' : '' %> — qui l'emporte ?</p>
      <% const drawForm = () => { %>
        <form method="post" action="/free-play/<%= match._id %>/games">
          <input type="hidden" name="gameResult" value="draw">
          <button class="btn btn-report btn-draw-mid"><span class="who">Nul</span><span class="sub">égalité / temps</span></button>
        </form>
      <% }; %>
      <div class="report-buttons<%= spec.sides > 2 ? ' report-buttons-' + spec.sides : '' %>">
        <% match.sides.forEach((side, i) => { %>
          <% if (spec.sides === 2 && i === 1) drawForm(); %>
          <form method="post" action="/free-play/<%= match._id %>/games">
            <input type="hidden" name="gameResult" value="<%= i %>">
            <button class="btn btn-report <%= i === 0 ? 'btn-win-left' : i === match.sides.length - 1 ? 'btn-win-right' : 'btn-win-mid' %>"><span class="who"><%= sideName(side) %></span><span class="sub">gagne la manche</span></button>
          </form>
        <% }) %>
        <% if (spec.sides > 2) drawForm(); %>
      </div>
      <p class="muted">Première à <%= need %> manche<%= need > 1 ? 's' : '' %> gagnée<%= need > 1 ? 's' : '' %>.<%= spec.sides > 2 ? ' En cas d’égalité en tête au bout du Bo, une manche de départage est jouée.' : '' %> Le match se clôture tout seul une fois décidé ; sinon, « Clôturer au score » enregistre le score en l'état.</p>

      <% const cur = games.played + 1; %>
      <% if (sidingGames.includes(cur)) { %>
        <% if (me) { const mine = mySiding.games[cur] || null; const prev = prevSideOf(cur); const others = players.filter((p) => String(p.userId) !== myId); %>
          <details class="siding-panel siding-panel-current siding-current" id="<%= catchUp.length ? 'siding-form-current' : 'side-deck' %>">
            <summary>
              <span class="siding-panel-title">🔁 Mon side pour la manche <%= cur %></span>
              <span class="siding-panel-summary">
                <% if (mine) { %><%- include('../partials/siding-chips', { sd: mine, sdk: null, n: cur, cardImage, thumb, inline: true }) %>
                <% } else { %><span class="muted">optionnel — aucun échange noté</span><% } %>
              </span>
              <span class="badge <%= mine ? 'badge-ok' : 'badge-open' %>"><%= mine ? 'noté' : 'à noter' %></span>
              <span class="muted siding-current-opp"><%= others.map((p) => sideLineOf(p, cur)).join(' · ') %></span>
            </summary>
            <div class="siding-panel-body">
              <% if (mine && sidedDecks[myId][cur]) { const sdk = sidedDecks[myId][cur]; %>
                <details class="sided-deck">
                  <summary class="btn btn-ghost btn-small">🃏 Deck joué en manche <%= cur %> <span class="muted">(principal <%= sdk.mainCount %> · réserve <%= sdk.sideCount %>)</span></summary>
                  <div class="sided-deck-view">
                    <p class="muted"><span class="sided-badge sided-badge-inline sided-in">IN</span> entrée dans le deck principal, <span class="sided-badge sided-badge-inline sided-out">OUT</span> sortie en réserve, par rapport au deck inscrit.</p>
                    <%- include('../partials/deck-view', { resolved: sdk.resolved, thumb, compact: true, highlight: sdk.highlight }) %>
                  </div>
                </details>
              <% } %>
              <%- include('../partials/siding-form', { n: cur, mine, prev, myDeckLines, cardImage, action: sidingAction }) %>
            </div>
          </details>
        <% } else { %>
          <div class="manche-side manche-side-current"><span class="muted">🔁 <%= players.map((p) => sideLineOf(p, cur)).join(' · ') %></span></div>
        <% } %>
      <% } %>
    </div>
  <% } %>

  <% if (catchUp.length) { %>
    <details class="siding-form siding-form-after" id="side-deck">
      <summary class="btn btn-ghost btn-small">🔁 Noter / corriger mes sides des manches déjà jouées</summary>
      <% for (const n of catchUp) { const mine = mySiding.games[n] || null; %>
        <h4>Manche <%= n %></h4>
        <%- include('../partials/siding-form', { n, mine, prev: prevSideOf(n), myDeckLines, cardImage, action: sidingAction }) %>
      <% } %>
    </details>
  <% } %>

  <% if (match.status === 'terminé') { %>
    <div class="cup-banner match-final">
      <% if (match.result === 'draw') { %>Match nul <%= games.wins.join('-') %>
      <% } else if (match.result === null || match.result === undefined) { %>Match clôturé sans manche jouée
      <% } else { %>🎉 <strong><%= sideName(match.sides[match.result]) %></strong> remporte le match <%= games.wins[match.result] %>-<%= games.wins.filter((w, i) => i !== match.result).join('-') %><% } %>
    </div>
  <% } else if (!canReport) { %>
    <p class="muted">Seuls les participants ou le créateur du match peuvent saisir le résultat<%= currentUser ? '' : ' — connecte-toi' %>.</p>
  <% } %>

  <% if (currentUser && (canReport || owner || match.status === 'terminé')) { %>
    <div class="row-actions fp-actions">
      <% if (canReport && games.played > 0 && !decided) { %>
        <form method="post" action="/free-play/<%= match._id %>/finish" class="inline" data-confirm="Clôturer le match au score en l'état ?">
          <button class="btn btn-ghost btn-small">🏁 Clôturer au score</button>
        </form>
      <% } %>
      <% if (canReport && games.played > 0) { %>
        <form method="post" action="/free-play/<%= match._id %>/reset" class="inline" data-confirm="Effacer toutes les manches saisies pour ce match ?">
          <button class="btn btn-danger-text btn-small">↺ Réinitialiser la saisie</button>
        </form>
      <% } %>
      <% if (match.status === 'terminé' && (owner || match.sides.some(s => s.players.some(p => String(p.userId) === currentUser.id)))) { %>
        <form method="post" action="/free-play/<%= match._id %>/reopen" class="inline">
          <button class="btn btn-ghost btn-small">↺ Rouvrir le match</button>
        </form>
      <% } %>
      <% if (owner) { %>
        <form method="post" action="/free-play/<%= match._id %>/delete" class="inline" data-confirm="Le match et ses manches seront supprimés définitivement." data-confirm-title="Supprimer ce match ?">
          <button class="btn btn-danger-text btn-small">Supprimer le match</button>
        </form>
      <% } %>
    </div>
  <% } %>
</div>

<% if (match.status === 'terminé') { %>
<%- include('_siding') %>
<% } %>

<%- include('../partials/foot') %>
