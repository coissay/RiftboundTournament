<%- include('../partials/head', { title: 'Nouveau match free play' }) %>

<p><a href="/free-play" class="muted">← Free play</a></p>

<div class="card card-medium">
  <h1>Nouveau match free play</h1>
  <form method="post" action="/free-play/new" id="fp-form">
    <label>Format
      <select name="format" id="fp-format">
        <% for (const [key, spec] of Object.entries(FORMATS)) { %>
          <option value="<%= key %>" <%= values.format === key ? 'selected' : '' %>><%= spec.label %> — <%= spec.description %></option>
        <% } %>
      </select>
    </label>
    <% const initialNote = FORMATS[values.format] && FORMATS[values.format].note; %>
    <p class="form-hint muted" id="fp-format-note" <%= initialNote ? '' : 'hidden' %>><%= initialNote || '' %></p>
    <label>Manches (Best of)
      <select name="bestOf">
        <option value="1" <%= values.bestOf == 1 ? 'selected' : '' %>>Best of 1 (une manche sèche)</option>
        <option value="3" <%= values.bestOf == 3 ? 'selected' : '' %>>Best of 3 (2 manches gagnantes)</option>
        <option value="5" <%= values.bestOf == 5 ? 'selected' : '' %>>Best of 5 (3 manches gagnantes)</option>
      </select>
    </label>
    <label>Date et heure <input type="datetime-local" name="date"></label>
    <p class="form-hint muted">Préremplie à maintenant — modifie-la pour saisir un match joué plus tôt.</p>

    <p class="fp-slots-label">Joueurs</p>
    <div id="fp-slots"></div>
    <p class="form-hint muted">Le deck est facultatif, mais sans deck le match ne compte pas dans les stats par deck.</p>

    <details class="guest-add fp-guest-add" id="fp-guest">
      <summary class="btn btn-ghost btn-small">+ Joueur sans compte</summary>
      <div class="guest-form">
        <label>Pseudo <input id="fp-guest-username" form="none" minlength="2" maxlength="40" placeholder="ex : Sam" autocomplete="off"></label>
        <label>E-mail <input id="fp-guest-email" form="none" type="email" placeholder="sam@exemple.fr" autocomplete="off"></label>
        <button type="button" class="btn btn-gold" id="fp-guest-add">Ajouter</button>
      </div>
      <p class="muted">Il/elle est ajouté·e à la liste des joueurs et reçoit un lien pour créer son compte et garder son historique<%= mailConfigured ? '' : ' (e-mail non configuré : le lien te sera affiché à transmettre)' %>. Sans compte, pas de deck à choisir pour cette place.</p>
      <p class="fp-guest-msg" id="fp-guest-msg" hidden></p>
    </details>

    <label>Note <input name="notes" maxlength="500" placeholder="ex : pause déj, test du nouveau deck…"></label>

    <div class="row-actions">
      <button class="btn btn-gold">Créer le match</button>
      <a href="/free-play" class="btn btn-ghost">Annuler</a>
    </div>
  </form>
</div>

<script>
  window.FP_FORM = {
    formats: <%- jsonForScript(Object.fromEntries(Object.entries(FORMATS).map(([k, s]) => [k, { sides: s.sides, perSide: s.perSide, note: s.note || null }]))) %>,
    users: <%- jsonForScript(users) %>,
    decksByOwner: <%- jsonForScript(decksByOwner) %>,
    me: <%- jsonForScript(currentUser ? currentUser.id : null) %>,
  };
</script>
<script src="/freeplay-form.js"></script>

<%- include('../partials/foot') %>
